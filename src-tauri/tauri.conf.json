{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "leeflet",
  "version": "0.5.0",
  "identifier": "com.leeflet.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "leeflet",
        "width": 1060,
        "height": 680,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "transparent": false,
        "backgroundColor": [15, 15, 17, 255],
        "shadow": true,
        "dragDropEnabled": false
      },
      {
        "label": "quick_capture",
        "title": "New Item",
        "url": "/?window=capture",
        "width": 460,
        "height": 330,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer_icon.ico",
        "sidebarImage": "icons/nsis_sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MDNBQTBDMEY1RjcxQkQKUldTOWNWOFBES29EWkk4V2p2RWxIdERVSC84UHp0MWkzcXMwczFObnJmSnFLQUcvRzhvcUJGckgK",
      "endpoints": [
        "https://github.com/christliebdela/leeflet/releases/latest/download/latest.json"
      ]
    }
  }
}
